rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // =================================
    // Users Collection
    // =================================
    match /users/{userId} {
      // CREATE: A user can create their own user document upon signup.
      allow create: if request.auth != null && request.auth.uid == userId;

      // READ: A user can read their own document.
      allow get: if request.auth != null && request.auth.uid == userId;
      
      // UPDATE: A user can update their own document.
      allow update: if request.auth != null && request.auth.uid == userId;

      // DELETE: A user can delete their own document.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // =================================
    // Blocked Users Collection
    // =================================
    match /blocked_users/{userId} {
      // No client-side reads or writes are allowed. Managed by admin processes.
      allow read, write: if false;
    }

    // =================================
    // Merchants Collection
    // =================================
    match /merchants/{merchantId} {
      // READ: Anyone can read a merchant's document if it is live.
      allow get: if resource.data.status == 'live';
      
      // LIST: Anyone can list merchants that are live. This is for the marketplace view.
      allow list: if request.query.get("status") == "live";

      // CREATE: A user can create a merchant application.
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      
      // UPDATE: Conditions for a merchant owner to update their own document.
      allow update: if request.auth.uid == resource.data.owner && (
          // Condition 1: Launching the store for the first time.
          (resource.data.status == 'approved' && 
           request.resource.data.status == 'live' && 
           request.resource.data.diff(resource.data).affectedKeys().hasAll(['status', 'walletAddress', 'seedPhrase'])) ||
           
          // Condition 2: Toggling the store's live/paused status.
          (resource.data.status in ['live', 'paused'] && 
           request.resource.data.status in ['live', 'paused'] &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
           
          // Condition 3: General updates to non-critical fields.
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
                'companyName', 'category', 'description', 'listings', 'logo', 'banner',
                'street', 'houseNumber', 'city', 'zipCode', 'country', 'state', 'province',
                'contactEmail', 'phone', 'website', 'instagram', 'taxNumber', 'position', 'geohash'
            ]))
        );
    }
    
    // =================================
    // Merchant Owners Lookup
    // =================================
    match /merchant_owners/{userId} {
        // READ: Only the owner can read their lookup doc. Useful for client-side checks.
        allow get: if request.auth != null && request.auth.uid == userId;
        // WRITE: No client-side writes. This is managed by backend/admin processes.
        allow write: if false;
    }

    // =================================
    // Admin-only Collections
    // =================================
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /tokenPurchaseRequests/{requestId} {
      allow read, write: if isAdmin();
      // Allow users to create their own requests
      allow create: if request.auth.uid == request.resource.data.userId;
    }
    
    match /merchantCashoutRequests/{requestId} {
       allow read, write: if isAdmin();
       // Allow merchant owners to create their own requests
       allow create: if request.auth.uid == get(/databases/$(database)/documents/merchants/$(request.resource.data.merchantId)).data.owner;
    }

    // =================================
    // Chat Collection
    // =================================
    match /chats/{chatId} {
      // READ/WRITE: Only participants of the chat can read or write to it.
      allow read, write: if request.auth.uid in resource.data.participantIds;

      // Nested messages collection
      match /messages/{messageId} {
        // READ: Only chat participants can read messages.
        allow read: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        
        // CREATE: A participant can add a message.
        allow create: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
        
        // UPDATE/DELETE: A user can only edit/delete their own messages.
        allow update, delete: if request.auth.uid == resource.data.senderId;
      }
    }
  }
}
