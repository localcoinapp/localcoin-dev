rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }
    
    function isMerchant() {
      return isSignedIn() && getUserData().role == 'merchant';
    }

    // Collection: users
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      // Allow user to write to their own doc, or an admin to write to any user doc,
      // or a merchant to update a user's doc (e.g. for order status).
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin() || isMerchant());
    }

    // Collection: merchants
    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'live' || (isSignedIn() && (isOwner(resource.data.owner) || isAdmin()));
      allow create: if isSignedIn();
      // Allow owner or admin to update.
      // Also allow any signed-in user for specific cart operations (inventory decrement).
      // The backend API is trusted to handle the logic securely.
      allow update: if isSignedIn() && (isOwner(resource.data.owner) || isAdmin() || request.resource.data.owner == resource.data.owner);
      allow delete: if isSignedIn() && (isOwner(resource.data.owner) || isAdmin());
    }

    // Collection: chats
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      // Subcollection: messages
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    // Admin-only Collections
    match /tokenPurchaseRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write, delete: if isAdmin();
    }
    
    match /merchantCashoutRequests/{requestId} {
      allow create: if isMerchant();
      allow read, write, delete: if isAdmin();
    }
    
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
