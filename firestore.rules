
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for common checks
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isMerchantOwner(merchantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/merchants/$(merchantId))
        && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
    }

    // ---------------- Merchants ----------------
    match /merchants/{merchantId} {
      // Public can read LIVE merchants. Owners and Admins can read their own/any.
      allow read: if resource.data.status == 'live' || isAdmin() || isMerchantOwner(merchantId);
      
      // Only Admins can create new merchant documents.
      allow create: if isAdmin();
      
      // Complex update logic for owners and admins.
      allow update: if isAdmin() || (
        isMerchantOwner(merchantId) && (
          // Use Case 1: Launching a store (approved -> live + wallet info)
          (request.resource.data.status == 'live' && resource.data.status == 'approved' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'walletAddress', 'seedPhrase'])) ||
          
          // Use Case 2: Toggling status between live and paused (allows metadata fields)
          (request.resource.data.status in ['live', 'paused'] && resource.data.status in ['live', 'paused'] &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||

          // Use Case 3: General settings updates (cannot change status or owner)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'companyName', 'category', 'logo', 'banner', 'aiHint', 'position', 'geohash',
            'description', 'listings', 'street', 'houseNumber', 'city', 'zipCode',
            'website', 'instagram', 'userEmail', 'contactEmail', 'phone', 'state', 'taxNumber', 'country'
          ]))
        )
      );
      
      // Only Admins can delete.
      allow delete: if isAdmin();
    }

    // --------------- Merchant Owner Lookup ---------------
    match /merchant_owners/{userId} {
      // Allows a logged-in user to read their OWN merchant owner entry.
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Allows a new merchant to create their own lookup entry.
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Admins can manage all entries.
      allow update, delete: if isAdmin();
    }

    // ---------------- Users ----------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // New users can create their own document.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --------------- Blocked Users ---------------
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }

    // --------------- Token Purchase Requests ---------------
    match /tokenPurchaseRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --------------- Merchant Cash-out Requests ---------------
    match /merchantCashoutRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && isMerchantOwner(resource.data.merchantId));
      allow create: if isSignedIn() && isMerchantOwner(request.resource.data.merchantId);
      allow update, delete: if isAdmin();
    }

    // ---------------- Chats & Messages ----------------
    match /chats/{chatId} {
      // Must be a participant or an admin to interact with chats.
      allow read, update, delete: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participantIds || isAdmin());

      match /messages/{messageId} {
        // Must be a participant or an admin to interact with messages.
        allow read, create, update, delete: if isSignedIn() && 
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
      }
    }
  }
}
