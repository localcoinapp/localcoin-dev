rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Functions ---
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(merchantId) {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.merchantId == merchantId;
    }

    // --- User Rules ---
    match /users/{userId} {
      // Admins can get/list any user. Users can only get their own document.
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      // Users can update their own document. Admins can update any.
      allow update: if request.auth.uid == userId || isAdmin();
      // Only admins can delete user documents.
      allow delete: if isAdmin();
      allow create: if request.auth.uid == userId;
    }

    // --- Blocked User Rules ---
    match /blocked_users/{userId} {
      // Only admins can access the blocked users list.
      allow read, write: if isAdmin();
    }
    
    // --- Merchant Rules ---
    match /merchants/{merchantId} {
      // ANYONE can read a single merchant document IF it is 'live'
      allow get: if resource.data.status == 'live';
      // AUTHENTICATED users can create a merchant application.
      allow create: if request.auth != null;
      // Admins and the merchant owner can update or delete.
      allow update, delete: if isOwner(merchantId) || isAdmin();
      
      // ANYONE can LIST merchants IF the query is for live merchants.
      allow list: if request.query.get('status') == 'live';

      // ADMINS can read/list/write everything regardless of status.
      allow read, write: if isAdmin();
    }

    // --- Lookup for merchant owners ---
    match /merchant_owners/{userId} {
      allow read, create: if request.auth.uid == userId || isAdmin();
    }
    
    // --- Chat Rules ---
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
    
    // --- Financial Transaction Rules ---
    match /tokenPurchaseRequests/{requestId} {
      allow read, create: if request.auth.uid == resource.data.userId;
      allow list, update: if isAdmin();
    }
    
    match /merchantCashoutRequests/{requestId} {
      allow read, create: if isOwner(resource.data.merchantId);
      allow list, update: if isAdmin();
    }
  }
}