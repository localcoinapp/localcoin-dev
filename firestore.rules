
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Functions ---
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    function isOwner(merchantId) {
      // Check if the user is the owner of the merchant document.
      return request.auth.uid == get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner;
    }

    // --- Collections ---
    
    // USERS
    match /users/{userId} {
      // Admins can get any user doc, users can only get their own.
      allow get: if request.auth.uid == userId || isAdmin();
      // Only admins can list all users.
      allow list: if isAdmin();
      // Users can write to their own doc. Admins can write to any.
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // BLOCKED USERS
    match /blocked_users/{userId} {
      // Only admins can read or list blocked users.
      allow read, list: if isAdmin();
    }

    // MERCHANTS
    match /merchants/{merchantId} {
      // Public can read single live merchants, admins can read any.
      allow get: if resource.data.status == 'live' || isAdmin();
      // Public can query for live merchants, admins can list all.
      allow list: if request.query.where[0][2] == "live" || isAdmin();
      // Owners and admins can update.
      allow update: if isOwner(merchantId) || isAdmin();
      // Authenticated users can create merchant applications.
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      // Admins can delete.
      allow delete: if isAdmin();
    }
    
    // MERCHANT OWNERS (for security rule lookups)
    match /merchant_owners/{userId} {
      // A user can read their own merchant owner entry. Admins can read any.
      allow read: if request.auth.uid == userId || isAdmin();
    }

    // TOKEN PURCHASE REQUESTS
    match /tokenPurchaseRequests/{requestId} {
      // Admins can read/write/list. Users can read/write their own requests.
      allow read, write: if request.auth.uid == resource.data.userId || isAdmin();
      allow list: if isAdmin();
    }

    // MERCHANT CASHOUT REQUESTS
    match /merchantCashoutRequests/{requestId} {
      // Admins can read/write/list.
      allow read, write, list: if isAdmin();
    }

    // CHATS
    match /chats/{chatId} {
      // Participants of a chat can read/write to it.
      allow read, write: if request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        // Participants can read/write messages.
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
