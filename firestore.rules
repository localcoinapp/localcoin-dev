rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user making the request is an admin
    function isAdmin() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Check if the user is the owner of a specific merchant document
    function isOwner(merchantId) {
      return isSignedIn() && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
    }

    // Check if a user ID corresponds to any merchant
    function isMerchant(userId) {
        return exists(/databases/$(database)/documents/merchants/$(userId));
    }
    
    // USERS
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // BLOCKED USERS
    match /blocked_users/{userId} {
        allow read, write: if isAdmin();
    }

    // MERCHANTS
    match /merchants/{merchantId} {
      allow read: if get(/databases/$(database)/documents/merchants/$(merchantId)).data.status == 'live' || (isSignedIn() && (isOwner(merchantId) || isAdmin()));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(merchantId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(merchantId) || isAdmin());
    }
    
    // CHATS
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        match /messages/{messageId} {
            allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }
    }

    // TOKEN PURCHASE REQUESTS
    match /tokenPurchaseRequests/{requestId} {
      allow read, write: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/tokenPurchaseRequests/$(requestId)).data.userId == request.auth.uid);
      allow create: if isSignedIn();
    }

    // MERCHANT CASHOUT REQUESTS
    match /merchantCashoutRequests/{requestId} {
        allow read, write: if isSignedIn() && (isAdmin() || isOwner(get(/databases/$(database)/documents/merchantCashoutRequests/$(requestId)).data.merchantId));
        allow create: if isSignedIn() && isOwner(request.resource.data.merchantId);
    }
  }
}
