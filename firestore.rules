
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if a user is the owner of a given merchant
    function isMerchantOwner(merchantId) {
      return get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow user creation if the user is authenticated and the doc ID matches their UID
      allow create: if request.auth != null && request.auth.uid == userId;
      // Allow read/write access only to the user who owns the document, or an admin
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Rules for the 'merchants' collection
    match /merchants/{merchantId} {
      // ANYONE can list merchants if the query is for live stores
      allow list: if request.query.get('where') == [['status', '==', 'live']];
      // ANYONE can get a single merchant if it's live
      allow get: if resource.data.status == 'live';

      // Admins can do anything
      allow write: if isAdmin();
      
      // Merchants can update their OWN document under specific conditions
      allow update: if request.auth != null && isMerchantOwner(merchantId) && (
        // Condition 1: Launching a store (from 'approved' to 'live' and setting up wallet)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'walletAddress', 'seedPhrase']) &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'live'
        ) ||
        // Condition 2: Toggling store status between 'live' and 'paused'
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          (resource.data.status == 'live' || resource.data.status == 'paused') &&
          (request.resource.data.status == 'live' || request.resource.data.status == 'paused')
        )
      );
    }
    
    // Rules for other collections
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
    
    match /tokenPurchaseRequests/{requestId} {
      allow read, write: if request.auth != null; // Users can create/read their own, admin can read/update all
    }
    
    match /merchantCashoutRequests/{requestId} {
       allow read, write: if request.auth != null; // Merchants can create/read their own, admin can read/update all
    }

    match /merchant_owners/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /chats/{chatId} {
      // Users can read/write chats they are a part of
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      // Rules for subcollection of messages
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
