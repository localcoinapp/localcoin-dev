rules_version = '2';

service cloud.firestore {
  // Helpers
  function isSignedIn() {
    return request.auth != null && request.auth.uid != null;
  }

  // Safe admin check: checks for role without failing on non-existent docs.
  function isAdmin() {
    return isSignedIn()
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
  }

  // Helper to check if the user is only changing their own order status in pendingOrders
  function isChangingOwnOrderStatus(merchantId) {
    let requestOrders = request.resource.data.pendingOrders;
    let resourceOrders = resource.data.pendingOrders;
    let userId = request.auth.uid;

    // The number of orders must not change
    if (requestOrders.size() != resourceOrders.size()) {
      return false;
    }

    // Every order in the new list must have a corresponding order in the old list
    return requestOrders.forall(reqOrder =>
      resourceOrders.exists(resOrder =>
        // Find the matching order by ID
        resOrder.orderId == reqOrder.orderId &&
        // Ensure all immutable fields are unchanged
        resOrder.userId == reqOrder.userId &&
        resOrder.price == reqOrder.price &&
        resOrder.title == reqOrder.title &&
        resOrder.itemId == reqOrder.itemId &&
        // Only allow a change if the order belongs to the requesting user
        (
          (reqOrder.status != resOrder.status && resOrder.userId == userId) ||
          // Or if the order is completely identical (no change)
          (reqOrder == resOrder)
        )
      )
    );
  }

  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'live';
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      
      // Allow merchant owner or admin full update rights.
      // Allow a regular user to update ONLY to change their own order status.
      allow update: if isSignedIn() &&
                    ((request.auth.uid == resource.data.owner || isAdmin()) ||
                     isChangingOwnOrderStatus(merchantId));
                     
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.owner || isAdmin());
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participantIds || isAdmin());
      allow update, delete: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());

      match /messages/{messageId} {
        allow read, create, update, delete: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
      }
    }

    match /tokenPurchaseRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /merchantCashoutRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}