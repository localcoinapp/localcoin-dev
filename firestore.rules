rules_version = '2';
service cloud.firestore {

  // ---------- Helpers ----------
  function isSignedIn() {
    return request.auth != null && request.auth.uid != null;
  }

  // Accept admin either via users/{uid}.role == 'admin' OR a custom auth claim 'admin' (optional)
  function isAdmin() {
    return isSignedIn() && (
      (request.auth.token.admin == true) || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      )
    );
  }

  // Cross-collection owner check (don't call this inside /merchants/{id})
  function ownsMerchant(merchantId) {
    return isSignedIn()
      && exists(/databases/$(database)/documents/merchants/$(merchantId))
      && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
  }

  match /databases/{database}/documents {

    // ---------- Merchants ----------
    match /merchants/{merchantId} {
      // Local owner check without get()
      function isOwner() {
        return isSignedIn() && resource.data.owner == request.auth.uid;
      }

      // Public read of LIVE docs; owners/admins can read any
      // (Covers both get + list; no separate 'list' rule needed)
      allow read: if resource.data.status == 'live' || isAdmin() || isOwner();

      // Create policy: keep admin-only (uncomment next line instead if owners self-create)
      allow create: if isAdmin();
      // allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;

      // Owner launch: approved -> live (only these keys)
      function ownerCanLaunchStore() {
        return resource.data.status == 'approved'
          && request.resource.data.status == 'live'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status','walletAddress','seedPhrase']);
      }

      // Owner toggle: live <-> paused (status must change; allow optional metadata)
      function ownerCanToggleStatus() {
        let diff = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status in ['live','paused']
          && request.resource.data.status in ['live','paused']
          && request.resource.data.status != resource.data.status
          && diff.hasOnly(['status','updatedAt','updatedBy','statusNote'])
          && diff.hasAny(['status']);
      }

      // Owner general settings (no status/owner)
      function ownerCanUpdateSettings() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'companyName','category','logo','banner','aiHint','position','geohash',
          'description','listings','street','houseNumber','city','zipCode',
          'website','instagram','userEmail','contactEmail','phone','state','taxNumber','country',
          'updatedAt'
        ]);
      }

      // Updates allowed for admin, or owner within the allowed change sets
      allow update: if isAdmin() || (
        isOwner() && (
          ownerCanLaunchStore() ||
          ownerCanToggleStatus() ||
          ownerCanUpdateSettings()
        )
      );

      // Delete only by admin
      allow delete: if isAdmin();
    }

    // ---------- Merchant owner lookup ----------
    match /merchant_owners/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read:   if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------- Users ----------
    match /users/{userId} {
      // One rule covers get + list for admins
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // ---------- Blocked users ----------
    match /blocked_users/{userId} {
      // 'read' covers get + list; admin-only
      allow read, write: if isAdmin();
    }

    // ---------- Token purchase requests ----------
    match /tokenPurchaseRequests/{requestId} {
      // Admin can get/list all; users can read only their own docs
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- Merchant cashout requests ----------
    match /merchantCashoutRequests/{requestId} {
      allow read:   if isAdmin() || (isSignedIn() && ownsMerchant(resource.data.merchantId));
      allow create: if isSignedIn() && ownsMerchant(request.resource.data.merchantId);
      allow update, delete: if isAdmin();
    }

    // ---------- Chats ----------
    match /chats/{chatId} {
      allow read, update, delete: if isSignedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn()
        && (request.auth.uid in request.resource.data.participantIds || isAdmin());

      match /messages/{messageId} {
        allow read, create, update, delete: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
      }
    }
    
        // --- Global admin read bypass (covers both get + list) ---
    // This ensures all admin collection queries succeed everywhere.
    match /{docPath=**} {
      allow read: if isAdmin();
    }


    // Default deny
    match /{document=**} { allow read, write: if false; }
  }
}