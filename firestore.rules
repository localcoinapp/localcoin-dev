rules_version = '2';
service cloud.firestore {
  function isSignedIn() {
    return request.auth != null && request.auth.uid != null;
  }
  function isAdmin() {
    return isSignedIn()
      && exists(/databases/$(database)/documents/users/$(request.auth.uid))
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
  }

  match /databases/{database}/documents {
    // Users
    match /users/{userId} {
      allow create, read, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Merchants
    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'live'
               || (isSignedIn() && (request.auth.uid == resource.data.owner || isAdmin()));
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isSignedIn()
               && (request.auth.uid == resource.data.owner || isAdmin());
    }

    // Chats + messages
    match /chats/{chatId} {
      allow read: if isSignedIn()
               && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn()
               && (request.auth.uid in request.resource.data.participantIds || isAdmin());
      allow update, delete: if isSignedIn()
               && (request.auth.uid in resource.data.participantIds || isAdmin());

      match /messages/{messageId} {
        allow read, create, update, delete: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin())
          && (request.method != 'create' || request.resource.data.senderId == request.auth.uid);
      }
    }

    // Token purchase / cashout requests
    match /tokenPurchaseRequests/{id} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }
    match /merchantCashoutRequests/{id} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // Blocked users
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }

    // Everything else denied
    match /{document=**} { allow read, write: if false; }
  }
}
