
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isMerchant() {
      // Check if any merchant document has an owner field matching the user's UID
      return exists(
        /databases/$(database)/documents/merchants?where(owner,"==",request.auth.uid)
      );
    }
    
    // USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isMerchant();
      allow write: if isOwner(userId) || isAdmin() || isMerchant();
    }
    
    // BLOCKED USERS
    match /blocked_users/{userId} {
        allow read, write: if isAdmin();
    }

    // MERCHANTS
    match /merchants/{merchantId} {
      allow get: if resource.data.status == 'live' || isSignedIn();
      allow list: if true; // Allow listing live merchants
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Allow updates, backend logic will validate data
      allow delete: if isAdmin();
    }
    
    // TOKEN PURCHASE REQUESTS
    match /tokenPurchaseRequests/{requestId} {
      allow read, write: if isSignedIn() || isAdmin();
      allow create: if isSignedIn();
    }
    
    // MERCHANT CASHOUT REQUESTS
    match /merchantCashoutRequests/{requestId} {
        allow read, write: if isSignedIn() || isAdmin();
        allow create: if isSignedIn();
    }

    // CHATS
    match /chats/{chatId} {
      allow read, write: if request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
