
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isMerchant() {
      return isSignedIn() && exists(/databases/$(database)/documents/merchant_owners/$(request.auth.uid));
    }
    
    // --- Collection Rules ---

    // USERS:
    // - Admins can read/write any user.
    // - Users can read/write their own document.
    // - Merchants can read user documents (to see order details).
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId) || isMerchant();
      allow write: if isAdmin() || isOwner(userId);
    }
    
    // BLOCKED USERS:
    // - Only Admins can read/write.
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }

    // MERCHANTS:
    // - Anyone can read live merchants.
    // - Admins can read/write any merchant.
    // - The owner merchant can update their own document.
    match /merchants/{merchantId} {
      allow get: if resource.data.status == 'live' || isAdmin() || (isOwner(resource.data.owner));
      allow list: if isAdmin(); // Public listing is handled by a query for 'live' status
      allow create: if isSignedIn(); // Allow any signed-in user to create an application
      allow update: if isAdmin() || isOwner(resource.data.owner);
      allow delete: if isAdmin();
    }

    // MERCHANT OWNERS (Lookup table for rules):
    // - Only Admins can write to this. Read is used by rules.
    match /merchant_owners/{userId} {
      allow read: if isSignedIn(); // Allow rules to check this
      allow write: if isAdmin();
    }

    // CHATS:
    // - Only participants can read/write a chat document or its messages.
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
    
    // TOKEN & CASHOUT REQUESTS:
    // - Users can create their own requests.
    // - Admins can read/write all requests.
    match /tokenPurchaseRequests/{requestId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /merchantCashoutRequests/{requestId} {
       allow read: if isAdmin() || isOwner(get(/databases/$(database)/documents/merchants/$(resource.data.merchantId)).data.owner);
       allow create: if isOwner(get(/databases/$(database)/documents/merchants/$(request.resource.data.merchantId)).data.owner);
       allow update, delete: if isAdmin();
    }
  }
}
