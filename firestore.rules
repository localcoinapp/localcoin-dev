
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Functions ---
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    function isOwner(merchantId) {
      return request.auth.uid == get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner;
    }

    // --- Collections ---
    
    // USERS
    match /users/{userId} {
      allow get: if request.auth.uid == userId;
      allow list: if isAdmin();
      allow write: if request.auth.uid == userId;
    }

    // BLOCKED USERS
    match /blocked_users/{userId} {
      allow read, write, list: if isAdmin();
    }

    // MERCHANTS
    match /merchants/{merchantId} {
      allow get: if resource.data.status == 'live';
      allow list: if request.query.filters.size() == 1 && 
                   request.query.filters[0].field.stringValue() == 'status' && 
                   request.query.filters[0].value.stringValue() == 'live';
      allow update: if isOwner(merchantId) || isAdmin();
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    // MERCHANT OWNERS
    match /merchant_owners/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
    }

    // TOKEN PURCHASE REQUESTS
    match /tokenPurchaseRequests/{requestId} {
      allow read, write: if request.auth.uid == resource.data.userId || isAdmin();
      allow list: if isAdmin();
    }

    // MERCHANT CASHOUT REQUESTS
    match /merchantCashoutRequests/{requestId} {
      allow read, write: if isOwner(resource.data.merchantId) || isAdmin();
      allow list: if isAdmin();
    }

    // CHATS
    match /chats/{chatId} {
      allow read, write: if request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
    
    // --- Global Admin Bypass ---
    // This allows admins to read any document, which is crucial for the dashboard listeners.
    match /{path=**} {
        allow read: if isAdmin();
    }
  }
}

    