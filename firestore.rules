rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Functions ---
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Admins are identified by a custom claim, set by a server-side script.
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // --- Collections ---

    // Users:
    // - Admins can read/write any user document.
    // - Users can read/write their own document.
    match /users/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // Blocked Users:
    // - Only Admins can access this collection.
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
    
    // Merchants:
    // - Admins can read/write any merchant.
    // - Live merchants can be read by any authenticated user.
    // - Owners can update their own merchant document.
    match /merchants/{merchantId} {
      allow get: if isAuth() && (resource.data.status == 'live' || isAdmin());
      allow list: if isAuth(); // List is open, but client-side query should enforce 'live' status.
      allow read, write: if isAdmin() || isOwner(resource.data.owner);
    }
    
    // Merchant Owners Lookup:
    // - Used for security rules.
    // - Admins can read/write.
    // - Users can read their own entry.
    match /merchant_owners/{userId} {
       allow get: if isAdmin() || isOwner(userId);
       allow list, write: if isAdmin();
    }

    // Token Purchase Requests:
    // - Admins can read/write all requests.
    // - Users can create and read their own requests.
    match /tokenPurchaseRequests/{requestId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
    }

    // Merchant Cashout Requests:
    // - Admins can read/write all requests.
    // - Merchant owners can create requests.
    // - Merchant owners can read their own requests (via a query).
    match /merchantCashoutRequests/{requestId} {
       allow create: if isAuth() && get(/databases/$(database)/documents/merchants/$(request.resource.data.merchantId)).data.owner == request.auth.uid;
       allow read, write: if isAdmin();
       allow list: if isAdmin();
    }

    // Chats & Messages:
    // - Participants can read/write messages in a chat they are part of.
    match /chats/{chatId} {
      allow read, write: if isAuth() && request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        allow read, write: if isAuth() && get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAny([request.auth.uid]);
      }
    }
  }
}
