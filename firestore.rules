
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions to make rules more readable
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'admin';
    }
    
    function isMerchant() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'merchant';
    }

    function isOwner(merchantId) {
        return isSignedIn() && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isUser(userId) || isAdmin() || isMerchant();
    }
    
    // Rules for the 'merchants' collection
    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'live' || isOwner(merchantId) || isAdmin();
      allow create: if isSignedIn();
      // Allow owner/admin to change anything. 
      // Allow signed-in users to update if they are not maliciously changing ownership or wallet details.
      // This is necessary for cart/order transactions initiated by customers.
      allow update: if (isOwner(merchantId) || isAdmin()) || 
                    (isSignedIn() && request.resource.data.owner == resource.data.owner && request.resource.data.walletAddress == resource.data.walletAddress);
      allow delete: if isOwner(merchantId) || isAdmin();
    }
    
    // Rules for the 'blocked_users' collection
    match /blocked_users/{userId} {
        allow read, write: if isAdmin();
    }

    // Rules for chat functionality
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }
    
    // Rules for token purchase requests
    match /tokenPurchaseRequests/{requestId} {
        allow read, write: if isAdmin();
        allow create: if isSignedIn();
    }
    
    // Rules for merchant cash-out requests
    match /merchantCashoutRequests/{requestId} {
        allow read, write: if isAdmin();
        allow create: if isMerchant();
    }
  }
}
