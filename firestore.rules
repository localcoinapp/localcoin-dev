
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =================================
    // == Helper Functions
    // =================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isMerchant() {
      // Checks if a user is a verified merchant by looking for their UID in the dedicated lookup collection.
      // This is a fast and secure way to check for a role.
      return isSignedIn() && exists(/databases/$(database)/documents/merchant_owners/$(request.auth.uid));
    }
    
    // =================================
    // == Collection Rules
    // =================================

    // Rules for User Documents
    match /users/{userId} {
      // READ: 
      // - A user can get their own document.
      // - An admin can get any user's document.
      // - A merchant can get any user's document. THIS IS THE KEY FIX. It allows merchants to see customer
      //   information when processing orders on their dashboard.
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isMerchant());
      
      // LIST (queries):
      // - Only an admin can perform a query to get a list of users.
      allow list: if isAdmin();

      // WRITE (create, update, delete):
      // - A user can write to their own document.
      // - An admin can write to any user's document.
      // - A merchant can update a user's document (e.g., to change order status in the user's cart).
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isMerchant());
    }

    // Rules for Merchant Documents
    match /merchants/{merchantId} {
      // READ:
      // - Anyone can read a merchant document if its status is 'live'.
      // - An admin can read any merchant document, regardless of status.
      // - The owner can read their own merchant document, regardless of status.
      allow read: if resource.data.status == 'live' || isAdmin() || (isSignedIn() && resource.data.owner == request.auth.uid);
      
      // CREATE:
      // - A user can create a merchant document only if they set themselves as the owner.
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      
      // UPDATE:
      // - The owner of the merchant document or an admin can update it.
      // - IMPORTANT: All other updates (like a customer adding to cart) must be handled
      //   by a trusted backend function using the Admin SDK, which bypasses these rules.
      allow update: if isSignedIn() && (isAdmin() || request.resource.data.owner == request.auth.uid);

      // DELETE:
      // - Only the owner or an admin can delete their merchant document.
      allow delete: if isSignedIn() && (isAdmin() || resource.data.owner == request.auth.uid);
    }
    
    // Rules for the merchant owner lookup collection
    match /merchant_owners/{userId} {
        // READ: Allow any signed-in user to read. This is needed for the isMerchant() function to work.
        allow read: if isSignedIn();
        // WRITE: Only allow users to create/update their own entry. This is done in the become-merchant flow.
        allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Rules for Chat
    match /chats/{chatId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participantIds;
      }

      allow read, update, delete: if isSignedIn() && (isParticipant() || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participantIds || isAdmin());

      match /messages/{messageId} {
        function isChatParticipant() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }

        allow read: if isSignedIn() && (isChatParticipant() || isAdmin());
        allow create: if isSignedIn() && isChatParticipant();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    // Rules for Financial Requests
    match /tokenPurchaseRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /merchantCashoutRequests/{requestId} {
      allow create: if isSignedIn() && isMerchant();
      allow read, write: if isAdmin();
    }

    // Blocked users can only be managed by admins
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
