
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Correctly check the role of the requesting user.
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Correctly check if a merchant document exists where the owner is the requesting user.
    function isMerchant() {
      return isSignedIn() && exists(
        /databases/$(database)/documents/merchants/$(request.resource.data.merchantId)
      );
    }
    
    // Check if the user making the request is a listed merchant owner.
    // This is used for rules where a merchant needs to act on another user's document.
    function requestorIsAMerchant() {
        return isSignedIn() && exists(/databases/$(database)/documents/merchants/$(request.auth.uid));
    }


    // Rules for Collections
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin() || requestorIsAMerchant());
    }

    match /merchants/{merchantId} {
      allow read: if get(/databases/$(database)/documents/merchants/$(merchantId)).data.status == 'live' || (isSignedIn() && (isOwner(get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner) || isAdmin()));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(resource.data.owner) || isAdmin() || request.resource.data.keys().hasAny(['pendingOrders', 'listings', 'recentTransactions']));
      allow delete: if isSignedIn() && (isOwner(resource.data.owner) || isAdmin());
    }

    match /chats/{chatId} {
        allow read, write: if isSignedIn() && request.auth.uid in resource.data.participantIds;
    }

    match /chats/{chatId}/messages/{messageId} {
        allow read, write, delete: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    match /blocked_users/{userId} {
      allow read, write: if isSignedIn() && isAdmin();
    }
    
    match /tokenPurchaseRequests/{requestId} {
        allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && isAdmin();
    }
    
    match /merchantCashoutRequests/{requestId} {
        allow read, write: if isSignedIn() && (isOwner(get(/databases/$(database)/documents/merchants/$(resource.data.merchantId)).data.owner) || isAdmin());
    }
  }
}
