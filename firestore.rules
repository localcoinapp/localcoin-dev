rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // == Admin-only collections
    // ============================================================
    match /blocked_users/{userId} {
      allow read, write: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /tokenPurchaseRequests/{requestId} {
      allow read, write: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
     match /merchantCashoutRequests/{requestId} {
      allow read, write: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /merchant_owners/{ownerId} {
      allow read, write: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // ============================================================
    // == Users collection rules
    // ============================================================
    match /users/{userId} {
      // ANYONE CAN CREATE: A new user can create their own document.
      allow create: if request.auth.uid != null && request.auth.uid == userId;

      // USERS can read/update their OWN data. ADMINS can read/write ANY user data.
      allow read, update: if request.auth.uid == userId || (request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // ONLY ADMINS can delete users
      allow delete: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ============================================================
    // == Merchants collection rules
    // ============================================================
    match /merchants/{merchantId} {
      // ANYONE can list merchants that are 'live'
      allow list: if request.query.get("status") == "live";
      
      // ANYONE can read a single merchant document.
      allow get: if true;

      // A user can CREATE a merchant document if they are logged in.
      allow create: if request.auth.uid != null;
      
      // An owner can UPDATE their own document under specific conditions.
      allow update: if request.auth.uid == resource.data.owner && (
          // Condition 1: Launching the store (from approved to live)
          (request.resource.data.status == 'live' && resource.data.status == 'approved') ||
          // Condition 2: Toggling status between live and paused
          (request.resource.data.status in ['live', 'paused'] && resource.data.status in ['live', 'paused']) ||
          // Condition 3: General updates to non-critical fields by the owner
          (request.resource.data.keys().diff(resource.data.keys()).hasOnly(['companyName', 'category', 'logo', 'banner', 'description', 'listings', 'position', 'geohash', 'street', 'houseNumber', 'city', 'zipCode', 'website', 'instagram', 'contactEmail', 'phone', 'taxNumber', 'state']))
      );
    }
    
    // ============================================================
    // == Chats collection rules
    // ============================================================
    match /chats/{chatId} {
      // Allow read/write only if the user is a participant.
      allow read, write: if request.auth.uid != null && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
         // Allow read if user is participant in the parent chat
         allow read: if request.auth.uid != null && get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAny([request.auth.uid]);
         
         // Allow create if user is the sender. Allow delete/update for sender on their own messages.
         allow create, update, delete: if request.auth.uid == request.resource.data.senderId;
      }
    }
  }
}