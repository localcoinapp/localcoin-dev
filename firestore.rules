rules_version = '2';
service cloud.firestore {
  // Helpers
  function isSignedIn() {
    return request.auth != null && request.auth.uid != null;
  }

  function isAdmin() {
    // Safely check for admin role. The `get()` method handles non-existent docs.
    return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
  }

  function isOwner(merchantId) {
    // Check if the requesting user is the owner of the merchant document.
    return isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner;
  }

  function isMerchantModifyingUserCart(userId) {
    // Check if the incoming write to a user's doc is being done by a legitimate merchant for an order they own.
    // This is complex to do perfectly in rules, so we trust the backend API for the logic,
    // but we can at least verify the requester has a merchant role.
    let requesterIsMerchant = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    return isSignedIn() && requesterIsMerchant;
  }


  match /databases/{database}/documents {
    // Users can update their own document. A merchant can also update a user's cart. Admins can read any.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isMerchantModifyingUserCart(userId));
    }

    // Public can read live merchants. Owners and admins have full control.
    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'live' || (isSignedIn() && (isOwner(merchantId) || isAdmin()));
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isSignedIn() && (isOwner(merchantId) || isAdmin());
    }

    // Chat participants or admins can read/write chats and their messages.
    match /chats/{chatId} {
      function userIsParticipant() {
        return request.auth.uid in resource.data.participantIds;
      }
      function userIsCreatingParticipant() {
         return request.auth.uid in request.resource.data.participantIds;
      }
      function userCanAccessChat() {
          let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
          return request.auth.uid in chatDoc.data.participantIds;
      }

      allow read, update, delete: if isSignedIn() && (userIsParticipant() || isAdmin());
      allow create: if isSignedIn() && (userIsCreatingParticipant() || isAdmin());

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (userCanAccessChat() || isAdmin());
      }
    }

    // Users can create requests. Only admins can manage them.
    match /tokenPurchaseRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // Merchants/Users can create requests. Only admins can manage them.
    match /merchantCashoutRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // Blocked users: admin only
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
