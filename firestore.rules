
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isMerchant() {
      return exists(/databases/$(database)/documents/merchant_owners/$(request.auth.uid));
    }
    
    function getMerchantId() {
      return get(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)).data.merchantId;
    }

    // USER-RELATED RULES
    match /users/{userId} {
      allow read: if isUserAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !("role" in request.resource.data);
    }

    match /blocked_users/{userId} {
        allow read, write: if false; // No client access
    }

    // MERCHANT-RELATED RULES
    match /merchants/{merchantId} {
      allow read: if true; // Publicly readable
      
      // Allow creation only if the user doesn't already have a merchant application
      allow create: if isUserAuthenticated() 
                    && !isMerchant()
                    && request.resource.data.owner == request.auth.uid;
      
      // Allow an owner to update their store, with specific rules
      allow update: if isUserAuthenticated() && isOwner(resource.data.owner)
                    // Rule for launching the store
                    && (
                      request.resource.data.status == 'live' 
                      && resource.data.status == 'approved'
                      && request.resource.data.walletAddress != null
                      && request.resource.data.seedPhrase != null
                      && request.resource.data.keys().hasAll(['status', 'walletAddress', 'seedPhrase'])
                    )
                    // Rule for general updates by an active merchant
                    || (
                      resource.data.status in ['live', 'paused']
                      && !(
                        'owner' in request.resource.data || 
                        'rating' in request.resource.data || 
                        'status' in request.resource.data ||
                        'walletAddress' in request.resource.data ||
                        'seedPhrase' in request.resource.data
                      )
                    );
    }

    match /merchant_owners/{userId} {
        allow read: if isUserAuthenticated();
        allow write: if false; // Can only be written by admin/backend
    }

    // TOKEN & CASHOUT REQUESTS (Handled by Admin SDK)
    match /tokenPurchaseRequests/{requestId} {
        allow read: if isUserAuthenticated() && resource.data.userId == request.auth.uid;
        allow create, update, delete: if false; // Admin only
    }

    match /merchantCashoutRequests/{requestId} {
        allow read: if isUserAuthenticated() && isMerchant() && resource.data.merchantId == getMerchantId();
        allow create: if isUserAuthenticated() && isMerchant() && request.resource.data.merchantId == getMerchantId();
        allow update, delete: if false; // Admin only
    }

    // CHAT-RELATED RULES
    match /chats/{chatId} {
      allow read, update: if isUserAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isUserAuthenticated() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if isUserAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow update, delete: if isUserAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
