rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if a user is a merchant owner
    function isMerchantOwner(merchantId) {
      return exists(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)).data.merchantId == merchantId;
    }

    // ==================================================================
    //  USERS Collection
    // ==================================================================
    match /users/{userId} {
      // READ: Allow users to read their own profile. Admins can read any profile.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // READ_LIST: Allow logged-in users to read the list (e.g., for admin panel)
      allow list: if request.auth != null && isAdmin();

      // CREATE: A user can create their own document, but not for others.
      // This is crucial for the sign-up flow.
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // UPDATE: Allow users to update their own profile. Admins can update any.
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // DELETE: Only admins can delete user documents.
      allow delete: if request.auth != null && isAdmin();
    }
    
    // ==================================================================
    //  BLOCKED USERS Collection (Admin only)
    // ==================================================================
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }

    // ==================================================================
    //  MERCHANTS Collection
    // ==================================================================
    match /merchants/{merchantId} {
      // READ: Anyone can read merchant info if it is 'live'
      allow get: if resource.data.status == 'live';
      
      // READ_LIST: Anyone can list merchants that are 'live'
      allow list: if request.query.get("status") == "live";
      
      // CREATE: Only authenticated users can create a merchant application (doc)
      allow create: if request.auth != null;
      
      // UPDATE:
      // Allow an owner to update their own merchant document.
      // Allow an owner to "launch" by writing status/wallet/seed phrase if status is 'approved'.
      // Admins can update any merchant document.
      allow update: if request.auth != null &&
                    (isMerchantOwner(merchantId) || isAdmin() ||
                     (request.auth.uid == resource.data.owner &&
                      request.resource.data.status == 'live' &&
                      resource.data.status == 'approved' &&
                      request.resource.data.walletAddress != null &&
                      request.resource.data.seedPhrase != null
                     ));
      
      // DELETE: Only admins can delete merchants
      allow delete: if isAdmin();
    }
    
    // ==================================================================
    //  MERCHANT_OWNERS Lookup Collection
    // ==================================================================
    match /merchant_owners/{userId} {
        // READ: Only the owner or an admin can see this lookup doc.
        allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
        // WRITE: Only admins can create/update these lookups.
        allow write: if isAdmin();
    }
    
    // ==================================================================
    //  TOKEN/CASHOUT REQUESTS (Admin only for read/write)
    // ==================================================================
    match /tokenPurchaseRequests/{requestId} {
        allow read, write: if request.auth != null; // User creates, admin reads/updates
    }
    
    match /merchantCashoutRequests/{requestId} {
        allow read, write: if request.auth != null; // Merchant creates, admin reads/updates
    }

    // ==================================================================
    //  CHATS Collection
    // ==================================================================
    match /chats/{chatId} {
      // READ/WRITE: Only participants of the chat can access it.
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantIds;

      // CREATE: Any authenticated user can create a chat.
      allow create: if request.auth != null;

      // Match messages subcollection
      match /messages/{messageId} {
        // READ/WRITE: Only participants of the parent chat can access messages.
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        // CREATE: Any authenticated user can create a message.
        allow create: if request.auth != null;
      }
    }
  }
}
