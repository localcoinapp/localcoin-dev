
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // Helper functions
    // =============================================
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isMerchantOwner(merchantId) {
      return isAuth() && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
    }

    // =============================================
    // Merchants Collection Rules
    // =============================================
    match /merchants/{merchantId} {

      // PUBLIC READ: Anyone can read a single merchant document if it is live.
      // PUBLIC LIST: Anyone can list merchants if the query is for live merchants.
      allow get: if resource.data.status == 'live';
      allow list: if request.query.where.status == 'live';

      // MERCHANT READ: A merchant owner can read their own document regardless of status.
      allow get: if isMerchantOwner(merchantId);

      // ADMIN READ: An admin can read any merchant document.
      allow get, list: if isAdmin();
      
      // CREATE: Only admins can create new merchant docs (the user application is done via a pending status).
      allow create: if isAdmin();
      
      // UPDATE: Permissions for updating a merchant document.
      allow update: if
        // Admin can update anything.
        isAdmin() ||
        // A merchant owner can perform specific updates on their own document.
        (isMerchantOwner(merchantId) && (
          // Use-case 1: Launching the store for the first time.
          (request.resource.data.status == 'live' && resource.data.status == 'approved' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'walletAddress', 'seedPhrase'])) ||
          // Use-case 2: Toggling the store status between live and paused.
          (request.resource.data.status in ['live', 'paused'] && resource.data.status in ['live', 'paused'] &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
          // Use-case 3: Updating general store settings (but not status or owner).
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'companyName', 'category', 'logo', 'banner', 'aiHint', 'position', 'geohash',
            'description', 'listings', 'street', 'houseNumber', 'city', 'zipCode',
            'website', 'instagram', 'userEmail', 'contactEmail', 'phone', 'state', 'taxNumber', 'country'
           ]))
        ));

      // DELETE: Only admins can delete merchants.
      allow delete: if isAdmin();
    }
    
    // =============================================
    // Merchant Owners Lookup Rules
    // =============================================
    match /merchant_owners/{userId} {
      // Admins can read/write.
      allow read, write: if isAdmin();
      // Users can create their own entry during the merchant application process.
      allow create: if isUser(userId);
    }
    
    // =============================================
    // Users Collection Rules
    // =============================================
    match /users/{userId} {
      // READ: Users can read their own document. Admins can read any user document.
      allow get: if isUser(userId) || isAdmin();
      allow list: if isAdmin();

      // CREATE: A user can create their own document.
      allow create: if isUser(userId);

      // UPDATE: Users can update their own document. Admins can update any.
      allow update: if isUser(userId) || isAdmin();

      // DELETE: Only admins can delete users (for now).
      allow delete: if isAdmin();
    }
    
    // =============================================
    // Blocked Users Collection Rules
    // =============================================
    match /blocked_users/{userId} {
      // Only admins can read or write to this collection.
      allow read, write, create, delete: if isAdmin();
    }
    
    // =============================================
    // Token/Cashout Request Rules
    // =============================================
    match /tokenPurchaseRequests/{requestId} {
      // Admins can manage all requests.
      allow read, list, write: if isAdmin();
      // Users can create their own requests and read their own history.
      allow create: if isUser(request.resource.data.userId);
      allow get, list: if isAuth() && request.query.where.userId == request.auth.uid;
    }

    match /merchantCashoutRequests/{requestId} {
      // Admins can manage all requests.
      allow read, list, write: if isAdmin();
      // Merchants can create their own requests.
      allow create: if isMerchantOwner(request.resource.data.merchantId);
      // Merchants can read their own history.
      allow get, list: if isAuth() && isMerchantOwner(request.query.where.merchantId);
    }
    
    // =============================================
    // Chat Rules
    // =============================================
    match /chats/{chatId} {
      // READ/WRITE: A user can read or write to a chat only if their UID is in the participantIds array.
      allow read, write: if isAuth() && request.auth.uid in resource.data.participantIds;
      
      // CREATE: A user can create a chat if their UID is one of the participants.
      allow create: if isAuth() && request.auth.uid in request.resource.data.participantIds;
      
      // Message Subcollection
      match /messages/{messageId} {
        // READ/WRITE: Inherits from parent chat.
        allow read, write: if isAuth() && get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAny([request.auth.uid]);
      }
    }
  }
}
