
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =================================
    // == Helper Functions
    // =================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      // Use exists() to prevent errors on non-existent user docs (e.g., during signup)
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isMerchant() {
      return isSignedIn() && exists(/databases/$(database)/documents/merchant_owners/$(request.auth.uid));
    }
    
    function isOwner(merchantId) {
      // This function is safe because it's only called in contexts where the merchant doc is guaranteed to exist.
      return isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner;
    }

    // =================================
    // == Collection Rules
    // =================================

    // Rules for User Documents
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isMerchant());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin() || request.auth.uid == userId;
    }

    // Rules for Merchant Documents
    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'live' || isOwner(merchantId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if isOwner(merchantId) || isAdmin();
      allow delete: if isOwner(merchantId) || isAdmin();
    }
    
    // Rules for the merchant owner lookup collection
    match /merchant_owners/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow write: if isAdmin(); // Admins might need to fix this
        allow delete: if isAdmin();
    }

    // Rules for Chat
    match /chats/{chatId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participantIds;
      }
      
      function isCreatingParticipant() {
        return request.auth.uid in request.resource.data.participantIds;
      }

      allow read, update, delete: if isSignedIn() && (isParticipant() || isAdmin());
      allow create: if isSignedIn() && (isCreatingParticipant() || isAdmin());

      match /messages/{messageId} {
        function isChatParticipant() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }

        allow read: if isSignedIn() && (isChatParticipant() || isAdmin());
        allow create: if isSignedIn() && isChatParticipant();
        allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.senderId);
      }
    }

    // Rules for Financial Requests
    match /tokenPurchaseRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /merchantCashoutRequests/{requestId} {
      allow create: if isSignedIn() && isMerchant();
      allow read, write: if isAdmin();
    }

    // Blocked users can only be managed by admins
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
