rules_version = '2';
service cloud.firestore {

  function isSignedIn() { return request.auth != null && request.auth.uid != null; }

  function isAdmin() {
    return isSignedIn()
      && exists(/databases/$(database)/documents/users/$(request.auth.uid))
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
  }

  function isMerchantOwner(merchantId) {
    return isSignedIn()
      && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
  }

  match /databases/{database}/documents {

    // ---------------- Merchants ----------------
    match /merchants/{merchantId} {
      // One rule covers both get & list. Public can read LIVE docs; owners/admins can read their own/any.
      allow read: if resource.data.status == 'live'
                   || isAdmin()
                   || isMerchantOwner(merchantId);

      // Your policy said only admins create merchants
      allow create: if isAdmin();

      // Owners can update limited fields; admins can update anything
      allow update: if isAdmin() || (
        isMerchantOwner(merchantId) && (
          // Launch: approved -> live (+ wallet/seed fields)
          (request.resource.data.status == 'live' && resource.data.status == 'approved' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','walletAddress','seedPhrase'])) ||
          // Toggle live/paused
          (request.resource.data.status in ['live','paused'] && resource.data.status in ['live','paused'] &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
          // General settings (not status/owner)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'companyName','category','logo','banner','aiHint','position','geohash',
            'description','listings','street','houseNumber','city','zipCode',
            'website','instagram','userEmail','contactEmail','phone','state','taxNumber','country'
          ]))
        )
      );

      allow delete: if isAdmin();
    }

    // --------------- Merchant owner lookup ---------------
    match /merchant_owners/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read, update, delete: if isAdmin();
    }

    // ---------------- Users ----------------
    match /users/{userId} {
      allow read:   if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --------------- Blocked users ---------------
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }

    // --------------- Token purchases ---------------
    match /tokenPurchaseRequests/{requestId} {
      // User can only see their own docs; admins see all
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --------------- Merchant cashouts ---------------
    match /merchantCashoutRequests/{requestId} {
      allow read:   if isAdmin() || (isSignedIn() && isMerchantOwner(resource.data.merchantId));
      allow create: if isSignedIn() && isMerchantOwner(request.resource.data.merchantId);
      allow update, delete: if isAdmin();
    }

    // ---------------- Chats + messages ----------------
    match /chats/{chatId} {
      allow read, update, delete: if isSignedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn()
        && (request.auth.uid in request.resource.data.participantIds || isAdmin());

      match /messages/{messageId} {
        allow read, create, update, delete: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}