
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin.
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if the requesting user is the owner of a given merchant.
    function isMerchantOwner(merchantId) {
      return request.auth.uid == get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner;
    }

    // Helper function to check if the user is a registered merchant.
    function isMerchant() {
        return exists(/databases/$(database)/documents/merchant_owners/$(request.auth.uid));
    }
    
    // =============================================
    //  Public and User-Specific Rules
    // =============================================

    // Anyone can read a merchant's document IF it is live.
    // Merchants can read their own document regardless of status.
    // Admins can read any merchant document.
    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'live' || 
                     (request.auth.uid != null && request.auth.uid == resource.data.owner) ||
                     (request.auth.uid != null && isAdmin());
      
      // Only the owner merchant or an admin can update a merchant document.
      allow write: if (request.auth.uid != null && (isMerchantOwner(merchantId) || isAdmin()));
    }

    // Users can read and write their own document.
    // Admins can read and write any user document.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }
    
    // Admins have full access to the blocked users list.
    match /blocked_users/{userId} {
       allow read, write: if isAdmin();
    }

    // =============================================
    //  Chat Rules
    // =============================================
    match /chats/{chatId} {
      // Participants of a chat can read/write to the chat document.
      allow read, write: if request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        // Participants can read/write messages within their chat.
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
    
    // =============================================
    //  Admin-Only Writable Collections
    // =============================================

    // Only admins can write to the merchant_owners lookup.
    match /merchant_owners/{userId} {
        allow read, write: if isAdmin();
    }

    // Logged-in users can create purchase requests. Admins can manage them.
    match /tokenPurchaseRequests/{requestId} {
        allow create: if request.auth.uid != null;
        allow read, update, delete: if isAdmin();
    }

    // Logged-in merchants can create cashout requests. Admins can manage them.
    match /merchantCashoutRequests/{requestId} {
        allow create: if request.auth.uid != null && isMerchant();
        allow read, update, delete: if isAdmin();
    }
  }
}
