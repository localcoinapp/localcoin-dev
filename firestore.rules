rules_version = '2';
service cloud.firestore {
  // Helpers
  function isSignedIn() {
    return request.auth != null && request.auth.uid != null;
  }

  function isAdmin() {
    return isSignedIn()
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
  }

  match /databases/{database}/documents {
    // Users can read and update their own document. Admins can read any.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // "write" includes create/update/delete; limit to self as you intended.
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Anyone can read live merchant data.
    // The owner, an admin, or any signed-in user can update a merchant document.
    // The "add to cart" function requires users to be able to update inventory.
    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'live';
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      // Allow any signed-in user to update (for cart functionality), but owner/admin can delete.
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.owner || isAdmin());
    }

    // Only chat participants can read/write messages.
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participantIds || isAdmin());
      allow update, delete: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
        allow create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
        allow update, delete: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
      }
    }

    // Users can create requests. Only admins can manage them.
    match /tokenPurchaseRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // Merchants/Users can create requests. Only admins can manage them.
    match /merchantCashoutRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // Blocked users: admin only
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
