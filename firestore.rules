rules_version = '2';
service cloud.firestore {
  // Helpers
  function isSignedIn() {
    return request.auth != null && request.auth.uid != null;
  }

function isAdmin() {
    // The `get()` method returns null if the document does not exist.
    // By checking `get(...).data.role` you can safely check the field
    // on a document that may or may not exist without causing an error.
    return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
}

  match /databases/{database}/documents {
    // Users can read and update their own document. Admins can read any.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // "write" includes create/update/delete; limit to self as you intended.
      allow write: if isSignedIn() && request.auth.uid == userId;
      // (Optional redundancy) Allow explicit create for signup:
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    // Anyone can read live merchant data. Only the owner or an admin can update.
    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'live';
      // During create, "resource" is not available; use request.resource.
      // Also ensure owner is set to the caller.
      allow create: if isSignedIn()
                    && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isSignedIn()
                    && (request.auth.uid == resource.data.owner || isAdmin());
    }

    // Only chat participants can read/write messages.
    match /chats/{chatId} {
      // For get/list/update/delete we can use resource.
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      // For create, use request.resource since resource doesn't exist yet.
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participantIds || isAdmin());
      allow update, delete: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());

      match /messages/{messageId} {
        // Always validate against the parent chat's participantIds
        allow read: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
        allow create: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
        allow update, delete: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
      }
    }

    // Users can create requests. Only admins can manage them.
    match /tokenPurchaseRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // Merchants/Users can create requests. Only admins can manage them.
    match /merchantCashoutRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // Blocked users: admin only
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
