
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if a user is a merchant and owns the specific resource
    function isMerchantOwner(merchantId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)).data.merchantId == merchantId;
    }
    
    // Helper function to check if a user is THE owner of a specific user document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ================================================================
    //   Users Collection
    // ================================================================
    match /users/{userId} {
      // Admins can read/write any user document.
      // Users can read/write their own document.
      allow read, write: if isAdmin() || isOwner(userId);
    }
    
    match /blocked_users/{userId} {
      // Only admins can read or write to the blocked users list.
      allow read, write: if isAdmin();
    }
    
    // ================================================================
    //   Merchants & Related Collections
    // ================================================================
    match /merchants/{merchantId} {
      // Allow public read only if the merchant is live.
      allow read: if resource.data.status == 'live';

      // Allow write access to the merchant who owns it, or any admin.
      allow write: if isMerchantOwner(merchantId) || isAdmin();
      
      // Allow a merchant or admin to read their own doc regardless of status.
      allow get: if isMerchantOwner(merchantId) || isAdmin();
    }

    // This collection is a lookup table for security rules.
    // It maps a user's UID to the merchantId they own.
    match /merchant_owners/{userId} {
      // Only admins should be able to create these lookup records.
      // Reads are done by the rules engine, not directly by clients.
      allow read, write: if isAdmin();
    }
    
    // ================================================================
    //   Financial & Order Collections
    // ================================================================
    match /tokenPurchaseRequests/{requestId} {
      // Admins can read/write any request.
      // Users can read their own requests.
      allow read: if isAdmin() || (isOwner(resource.data.userId));

      // Allow users to create their own purchase requests.
      // This is crucial for the Stripe payment flow.
      allow create: if isOwner(request.resource.data.userId);

      // Only admins can update (approve/deny) requests.
      allow update: if isAdmin();
    }
    
    match /merchantCashoutRequests/{requestId} {
       // Admins can manage all requests.
       // Merchants can read their own requests.
      allow read, write: if isAdmin() || (isMerchantOwner(resource.data.merchantId));
    }
    
    // ================================================================
    //   Chat Collection
    // ================================================================
    match /chats/{chatId} {
      // Users can only read/write chats they are a participant in.
      allow read, write: if request.auth.uid in resource.data.participantIds;
      
      // Messages subcollection inherits the parent's read/write rule.
      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
