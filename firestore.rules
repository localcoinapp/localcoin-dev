rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* -- helpers -- */
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.admin == "true" ||
        request.auth.token.role == "admin" ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        )
      );
    }

    function isOwner(merchantId) {
      return signedIn() &&
        request.auth.uid == get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner;
    }

    /* --- ADMIN FULL ACCESS OVERRIDE --- */
    match /{path=**} {
      allow read, write, list: if isAdmin();
    }

    /* --- USERS --- */
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow get, update, delete: if signedIn() && request.auth.uid == userId;
      allow list: if false;
    }

    /* --- BLOCKED USERS --- */
    match /blocked_users/{userId} {
      allow read, write, list: if false;
    }

    /* --- MERCHANTS --- */
    match /merchants/{merchantId} {
      allow get: if resource.data.status == "live";
      allow list: if true;
      allow create: if signedIn();
      allow update, delete: if isOwner(merchantId);
    }

    /* --- MERCHANT OWNERS --- */
    match /merchant_owners/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    /* --- TOKEN PURCHASE REQUESTS --- */
    match /tokenPurchaseRequests/{requestId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow get, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow list: if false;
    }

    /* --- MERCHANT CASHOUT REQUESTS --- */
    match /merchantCashoutRequests/{requestId} {
      allow create: if signedIn();
      allow get: if signedIn() &&
        request.auth.uid == get(/databases/$(database)/documents/merchants/$(resource.data.merchantId)).data.owner;
      allow list: if false;
      allow update, delete: if false;
    }

    /* --- CHATS --- */
    match /chats/{chatId} {
      allow create: if signedIn();
      allow get, update, delete:
        if signedIn() && request.auth.uid in resource.data.participantIds;
      allow list: if false;

      match /messages/{messageId} {
        allow create:
          if signedIn() &&
             request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow get, update, delete:
          if signedIn() &&
             request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow list: if false;
      }
    }
  }
}
