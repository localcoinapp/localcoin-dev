rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getRole(uid) {
        return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole(request.auth.uid) == 'admin';
    }

    function isMerchant() {
        return isSignedIn() && getRole(request.auth.uid) == 'merchant';
    }

    // Collections
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // A merchant can update a user's doc to update order status
      allow write: if isOwner(userId) || isMerchant() || isAdmin();
    }
    
    match /blocked_users/{userId} {
        allow read, write: if isAdmin();
    }

    match /merchants/{merchantId} {
      // Allow public read for live merchants, but owner/admin can read anytime
      allow read: if resource.data.status == 'live' || (isSignedIn() && (resource.data.owner == request.auth.uid || isAdmin()));
      // Any signed-in user can apply to become a merchant
      allow create: if isSignedIn();
      // Only the owner or an admin can update/delete the merchant document
      allow update, delete: if isSignedIn() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participantIds;
        
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }
    
    match /tokenPurchaseRequests/{requestId} {
        allow create: if isSignedIn();
        allow read, update, delete: if isAdmin();
    }
    
    match /merchantCashoutRequests/{requestId} {
        allow create: if isMerchant();
        allow read, update, delete: if isAdmin();
    }
  }
}
