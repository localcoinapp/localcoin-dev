rules_version = '2';
service cloud.firestore {

  // ---------- Helpers ----------
  function isSignedIn() {
    return request.auth != null && request.auth.uid != null;
  }

  // Admin check: Must be signed in, user document must exist, and role must be 'admin'
  function isAdmin() {
    return isSignedIn()
      && exists(/databases/$(database)/documents/users/$(request.auth.uid))
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
  }

  // Cross-collection owner check (safe to use outside the merchants collection)
  function ownsMerchant(merchantId) {
    return isSignedIn()
      && exists(/databases/$(database)/documents/merchants/$(merchantId))
      && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
  }

  match /databases/{database}/documents {

    // ---------- Merchants ----------
    match /merchants/{merchantId} {
      // Local owner check without extra get()
      function isOwner() {
        return isSignedIn() && resource.data.owner == request.auth.uid;
      }

      // Public can read LIVE merchants. Owners and Admins can read any merchant doc.
      allow read: if resource.data.status == 'live' || isAdmin() || isOwner();
      // Admins can list all merchants for their dashboard.
      allow list: if isAdmin();

      // Create policy (admin only; switch to self-create if desired)
      allow create: if isAdmin();

      // Owner can launch store: approved -> live (only these keys)
      function ownerCanLaunchStore() {
        return resource.data.status == 'approved'
          && request.resource.data.status == 'live'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status','walletAddress','seedPhrase']);
      }

      // Owner can toggle: live <-> paused (+ optional metadata)
      function ownerCanToggleStatus() {
        let diff = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status in ['live','paused']
          && request.resource.data.status in ['live','paused']
          && request.resource.data.status != resource.data.status
          && diff.hasOnly(['status','updatedAt','updatedBy','statusNote'])
          && diff.hasAny(['status']);
      }

      // Owner can update general settings (no status/owner changes)
      function ownerCanUpdateSettings() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'companyName','category','logo','banner','aiHint','position','geohash',
          'description','listings','street','houseNumber','city','zipCode',
          'website','instagram','userEmail','contactEmail','phone','state','taxNumber','country',
          'updatedAt'
        ]);
      }

      // Updates allowed for admin, or owner within the allowed change sets
      allow update: if isAdmin() || (
        isOwner() && (ownerCanLaunchStore() || ownerCanToggleStatus() || ownerCanUpdateSettings())
      );

      // Delete only by admin
      allow delete: if isAdmin();
    }

    // ---------- Merchant owner lookup ----------
    match /merchant_owners/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read:   if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------- Users ----------
    match /users/{userId} {
      // Admins can list all users.
      allow list: if isAdmin();
      // A user can read their own document. Admins can read any user document.
      // This is the key fix: allowing this read enables the isAdmin() check to succeed elsewhere.
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      // Allow read for backward compatibility with some queries, but GET is key.
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      // Users can create their own document.
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Users can update their own document, Admins can update any.
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      // Only admins can delete user documents.
      allow delete: if isAdmin();
    }


    // ---------- Blocked users (admin only) ----------
    match /blocked_users/{userId} {
      allow list, read, write: if isAdmin();
    }

    // ---------- Token purchase requests ----------
    match /tokenPurchaseRequests/{requestId} {
      // Admin can list/read all; users can read only their own.
      allow list: if isAdmin();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Users can create their own requests.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only admins can process (update/delete) requests.
      allow update, delete: if isAdmin();
    }

    // ---------- Merchant cashout requests ----------
    match /merchantCashoutRequests/{requestId} {
      // Admins can list/read all.
      allow list: if isAdmin();
      // Merchants can read their own cashout requests.
      allow read: if isAdmin() || (isSignedIn() && ownsMerchant(resource.data.merchantId));
      // Merchants can create their own requests.
      allow create: if isSignedIn() && ownsMerchant(request.resource.data.merchantId);
      // Only admins can process (update/delete) requests.
      allow update, delete: if isAdmin();
    }

    // ---------- Chats ----------
    match /chats/{chatId} {
      // Participants and admins can access chats.
      allow read, update, delete: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participantIds || isAdmin());

      // Messages can be accessed by chat participants or admins.
      match /messages/{messageId} {
        allow read, create, update, delete: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
      }
    }

    // Default deny all other access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
