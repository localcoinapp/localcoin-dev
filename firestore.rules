rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =================================================================
    // Helper Functions
    // =================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if the requesting user is the owner of a specific merchant document.
    function isOwner(merchantId) {
      return isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner;
    }

    // Check if the requesting user has an 'admin' role in their user document.
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Check if the requesting user is a merchant by looking up their UID in the merchant_owners collection.
    function isMerchant() {
      return isSignedIn() && exists(/databases/$(database)/documents/merchant_owners/$(request.auth.uid));
    }


    // =================================================================
    // Collection Rules
    // =================================================================
    
    // Rules for User Documents
    match /users/{userId} {
      // Allow a user to read their own document, or allow an admin/merchant to read any user document.
      // This is crucial for merchants to be able to process orders for users.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isMerchant());
      
      // Allow a user to write to their own document.
      // Allow an admin to write to any user document.
      // Allow a merchant to write to a user document (specifically for updating cart status).
      // The security of this operation is handled by trusted backend code.
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isMerchant());
    }
    
    // A lookup collection for merchants by owner UID.
    match /merchant_owners/{userId} {
        // Only admins can create/delete these lookup docs.
        // The application logic handles creation during merchant signup/approval.
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    // Rules for Merchant Documents
    match /merchants/{merchantId} {
      // Anyone can read a live merchant. Owner/Admin can read regardless of status.
      allow read: if resource.data.status == 'live' || isOwner(merchantId) || isAdmin();
      
      // A user can create a merchant document if they are signed in and are the owner.
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      
      // Allow owner/admin to update. 
      // Also allow any signed-in user to update the listings for cart transactions.
      allow update: if (isOwner(merchantId) || isAdmin()) || (isSignedIn() && request.resource.data.owner == resource.data.owner);

      // Only the owner or an admin can delete a merchant document.
      allow delete: if isOwner(merchantId) || isAdmin();
    }

    // Rules for Chat
    match /chats/{chatId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participantIds;
      }
      
      function isCreatingParticipant() {
        return request.auth.uid in request.resource.data.participantIds;
      }

      allow read, update, delete: if isSignedIn() && (isParticipant() || isAdmin());
      allow create: if isSignedIn() && (isCreatingParticipant() || isAdmin());

      match /messages/{messageId} {
        function isChatParticipant() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }

        allow read: if isSignedIn() && (isChatParticipant() || isAdmin());
        allow create: if isSignedIn() && isChatParticipant();
        allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.senderId);
      }
    }

    // Rules for Financial Requests
    match /tokenPurchaseRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /merchantCashoutRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // Blocked users can only be managed by admins
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
