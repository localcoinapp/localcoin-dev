rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is the owner of a merchant document.
    function isMerchantOwner(merchantId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)).data.merchantId == merchantId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'merchants' collection
    match /merchants/{merchantId} {
      // Anyone can read a merchant's data or list merchants based on status
      allow read, list: if true;
      // Allow owner to update their store, with specific rules for launching
      allow update: if isMerchantOwner(merchantId);
      // No one can create or delete directly (handled by admin/backend)
      allow create, delete: if false;
    }
    
    // Rules for the 'merchant_owners' collection (lookup table)
    match /merchant_owners/{userId} {
      // Only the user themselves can see their own lookup document. No one else.
      allow read: if request.auth != null && request.auth.uid == userId;
      // No one can write to this collection directly. It is managed by backend processes.
      allow write: if false;
    }

    // Rules for chats and messages
    match /chats/{chatId} {
      // User can read/write a chat if they are a participant
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        // User can read/write messages in a chat they are a part of
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }

    // Rules for token purchase and cashout requests
    match /tokenPurchaseRequests/{requestId} {
      // Users can create their own requests and read them. Admin can read/update.
      allow create, read: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow list, update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /merchantCashoutRequests/{requestId} {
      // Merchants can create their own requests. Admin can read/update.
      allow create: if request.auth != null && isMerchantOwner(request.resource.data.merchantId);
      allow read, list, update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the blocked users collection
    match /blocked_users/{userId} {
      // Only admins can access this collection
      allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
