
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Functions ---
    // Checks if a user has the 'admin' custom claim on their auth token.
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Checks if the requesting user is the owner of a document.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Checks if the user is the owner of the merchant document being accessed.
    function isMerchantOwner() {
      return get(/databases/$(database)/documents/merchants/$(request.resource.data.merchantId)).data.owner == request.auth.uid;
    }

    // --- Collections ---

    // Users: Can read/write their own document. Admins can read/write any.
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Blocked Users: Only admins can access.
    match /blocked_users/{userId} {
       allow read, write: if isAdmin();
    }

    // Merchants:
    // - Live merchants are publically readable.
    // - Owners can update their own merchant doc.
    // - Admins can read/write any merchant doc.
    match /merchants/{merchantId} {
      allow get: if resource.data.status == 'live';
      allow list: if isAdmin();
      allow read, write: if isAdmin() || (request.auth.uid == resource.data.owner);
    }
    
    // Merchant Owners Lookup:
    // - Used for security rules to quickly check if a user is a merchant.
    // - Admins can read.
    // - A user can read their own entry.
    match /merchant_owners/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow read: if isAdmin();
    }

    // Token Purchase Requests:
    // - Users can create their own.
    // - Admins can read/write all.
    match /tokenPurchaseRequests/{requestId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read, write: if isAdmin();
    }
    
    // Merchant Cashout Requests:
    // - Users who own the associated merchant can create.
    // - Admins can read/write all.
     match /merchantCashoutRequests/{requestId} {
      allow create: if isMerchantOwner();
      allow read, write: if isAdmin();
    }
    
    // Chats & Messages: Participants only.
    match /chats/{chatId} {
      allow read, write: if request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
