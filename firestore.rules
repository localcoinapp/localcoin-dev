rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      // Safely check for admin role. get() returns null for non-existent docs.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(merchantId) {
      // Check if the requesting user is the owner of the specified merchant document.
      return isSignedIn() && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
    }
    
    // --- Collection Rules ---

    // Users can read/update their own document. Admins have full access.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Anyone can read live merchants. Owners and Admins have full access.
    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'live' || isOwner(merchantId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isOwner(merchantId) || isAdmin();
    }

    // Participants and Admins can read/write chats and messages.
    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participantIds;
      }
      
      allow read, write: if isParticipant() || isAdmin();

      match /messages/{messageId} {
        allow read, write: if get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAny([request.auth.uid]) || isAdmin();
      }
    }

    // Users can create requests. Only admins can manage them.
    match /tokenPurchaseRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    
    match /merchantCashoutRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Only Admins can read or write to the blocked_users collection.
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
