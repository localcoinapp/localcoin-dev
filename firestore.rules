rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Correctly checks if a user is a merchant by querying the collection
    // on the 'owner' field.
    function isMerchant() {
      return isSignedIn() && exists(/databases/$(database)/documents/merchants?resource.data.owner==request.auth.uid);
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(merchantId) {
        return isSignedIn() && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
    }
    
    // /users/{userId}
    match /users/{userId} {
      // READ: An admin, a merchant, or the user themselves can read a user profile.
      allow read: if isAdmin() || isMerchant() || isUser(userId);
      // WRITE: An admin or the user themselves can write. A merchant can also write (to update cart status).
      allow write: if isAdmin() || isUser(userId) || isMerchant();
    }

    // /merchants/{merchantId}
    match /merchants/{merchantId} {
      // READ: Anyone can read a LIVE merchant's data. Admins and the owner can read it regardless of status.
      allow read: if resource.data.status == 'live' || isAdmin() || isOwner(merchantId);
      // CREATE: Only signed-in users can create a merchant application.
      allow create: if isSignedIn();
      // UPDATE: Admins, the owner, or any signed-in user can update (for cart actions), but sensitive fields are protected.
      allow update: if isAdmin() || isOwner(merchantId) || isSignedIn();
      // DELETE: Only admins or the owner can delete.
      allow delete: if isAdmin() || isOwner(merchantId);
    }
    
    // /chats/{chatId}
    match /chats/{chatId} {
        // READ/WRITE: You can only read or write to a chat if your user ID is in the participantIds array.
        allow read, write: if isSignedIn() && request.auth.uid in resource.data.participantIds;
        
        // MESSAGES Subcollection
        match /messages/{messageId} {
            // READ/CREATE: You can only read or create a message if you are a participant in the parent chat.
            allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
            // UPDATE/DELETE: You can only update or delete a message if you are the sender.
            allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
        }
    }

    // Admin-Only Collections
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }

    match /tokenPurchaseRequests/{requestId} {
      // CREATE: Any signed-in user can create a purchase request.
      allow create: if isSignedIn();
      // READ/UPDATE/DELETE: Only admins can manage requests after creation.
      allow read, update, delete: if isAdmin();
    }

    match /merchantCashoutRequests/{requestId} {
      // CREATE: Must be a verified merchant to create a cashout request.
      allow create: if isMerchant();
       // READ/UPDATE/DELETE: Only admins can manage requests after creation.
      allow read, update, delete: if isAdmin();
    }
  }
}
