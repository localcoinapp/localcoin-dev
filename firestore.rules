rules_version = '2';
service cloud.firestore {

  // ---------- Helpers ----------
  function isSignedIn() {
    return request.auth != null && request.auth.uid != null;
  }

  // Admin = custom auth claim only (no Firestore reads here)
  function isAdmin() {
    return isSignedIn() && request.auth.token.admin == true;
  }

  // Cross-collection owner check (safe)
  function ownsMerchant(merchantId) {
    return isSignedIn()
      && exists(/databases/$(database)/documents/merchants/$(merchantId))
      && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
  }

  match /databases/{database}/documents {

    // ---------- Merchants ----------
    match /merchants/{merchantId} {
      function isOwner() {
        return isSignedIn() && resource.data.owner == request.auth.uid;
      }

      // Public read of LIVE docs; owners/admins can read any
      allow read: if resource.data.status == 'live' || isAdmin() || isOwner();

      // Create: admin only (adjust if needed)
      allow create: if isAdmin();

      // Owner launch: approved -> live (only these keys)
      function ownerCanLaunchStore() {
        return resource.data.status == 'approved'
          && request.resource.data.status == 'live'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status','walletAddress','seedPhrase']);
      }

      // Owner toggle: live <-> paused (+ optional metadata)
      function ownerCanToggleStatus() {
        let diff = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status in ['live','paused']
          && request.resource.data.status in ['live','paused']
          && request.resource.data.status != resource.data.status
          && diff.hasOnly(['status','updatedAt','updatedBy','statusNote'])
          && diff.hasAny(['status']);
      }

      // Owner general settings (no status/owner)
      function ownerCanUpdateSettings() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'companyName','category','logo','banner','aiHint','position','geohash',
          'description','listings','street','houseNumber','city','zipCode',
          'website','instagram','userEmail','contactEmail','phone','state','taxNumber','country',
          'updatedAt'
        ]);
      }

      allow update: if isAdmin() || (
        isOwner() && (ownerCanLaunchStore() || ownerCanToggleStatus() || ownerCanUpdateSettings())
      );

      allow delete: if isAdmin();
    }

    // ---------- Merchant owner lookup ----------
    match /merchant_owners/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow update, delete: if isAdmin();
    }

    // ---------- Users ----------
    match /users/{userId} {
      // Admin can read any; users can read themselves
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin(); // Explicitly allow admin to list users
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // ---------- Blocked users (admin only) ----------
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }

    // ---------- Token purchase requests ----------
    match /tokenPurchaseRequests/{requestId} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- Merchant cashout requests ----------
    match /merchantCashoutRequests/{requestId} {
      allow read:   if isAdmin() || (isSignedIn() && ownsMerchant(resource.data.merchantId));
      allow list: if isAdmin();
      allow create: if isSignedIn() && ownsMerchant(request.resource.data.merchantId);
      allow update, delete: if isAdmin();
    }
    
    // ----- Other Admin list permissions ----
     match /merchants/{merchantId} {
        allow list: if isAdmin();
     }
     match /blocked_users/{userId} {
        allow list: if isAdmin();
     }


    // ---------- Chats ----------
    match /chats/{chatId} {
      allow read, update, delete: if isSignedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn()
        && (request.auth.uid in request.resource.data.participantIds || isAdmin());

      match /messages/{messageId} {
        allow read, create, update, delete: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
      }
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}