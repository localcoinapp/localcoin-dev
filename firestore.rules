
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isMerchantOwner(merchantId) {
      // Check if the user is the owner of the specified merchant document.
      // This reads from the merchant_owners lookup collection for efficiency.
      return get(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)).data.merchantId == merchantId;
    }
    
    // =============================================
    //  User Data
    // =============================================
    match /users/{userId} {
      // A user can read their own document.
      // Other authenticated users can read public profiles.
      allow read: if request.auth != null;
      
      // A user can create their own document (signup).
      allow create: if isOwner(userId);
      
      // A user can update their own document, but cannot change their role.
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
    }
    
    match /blocked_users/{userId} {
        // Only admins should be able to read/write this collection.
        // For simplicity here, we deny all client access.
        allow read, write: if false;
    }

    // =============================================
    //  Merchant Data
    // =============================================
    match /merchants/{merchantId} {
      // Anyone can read merchant data for the marketplace.
      allow read: if true;
      
      // Only the merchant owner can update their document.
      allow update: if request.auth != null && isMerchantOwner(merchantId);
      
      // Merchants cannot be created from the client side directly, only via application form
      // which uses a backend process.
      allow create: if false;
    }
    
    // This collection is a lookup for security rules.
    // It maps a user's UID to their merchant ID.
    match /merchant_owners/{userId} {
        // Only the server (Admin SDK) should write to this.
        // No client should be able to read or write this.
        allow read, write: if false;
    }


    // =============================================
    //  Transaction and Request Collections
    // =============================================
    match /tokenPurchaseRequests/{requestId} {
        // Users can only read their own requests.
        allow read: if request.auth != null && get(/databases/$(database)/documents/tokenPurchaseRequests/$(requestId)).data.userId == request.auth.uid;
        
        // No client-side creation, update, or deletion. This is handled by the Admin SDK.
        allow write: if false;
    }
    
    match /merchantCashoutRequests/{requestId} {
        // Only the relevant merchant can read their own cashout request.
        allow read: if request.auth != null && get(/databases/$(database)/documents/merchantCashoutRequests/$(requestId)).data.merchantId == get(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)).data.merchantId;
        
        // Merchants can create their own requests.
        allow create: if request.auth != null && request.resource.data.merchantId == get(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)).data.merchantId;

        // No client-side updates or deletions.
        allow update, delete: if false;
    }


    // =============================================
    //  Chat
    // =============================================
    match /chats/{chatId} {
      // Allow read/write only if the user is a participant in the chat.
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;
      
      match /messages/{messageId} {
        // Allow read/write only if the user is a participant in the parent chat.
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
