rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    // Users can read/write their own data, but not their role or merchantId.
    // Other signed-in users can read basic public info.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isUser(userId);
      allow update: if isUser(userId)
                    && !('role' in request.resource.data)
                    && !('merchantId' in request.resource.data);
      allow delete: if isUser(userId);
    }

    // Merchants are public-read, but can only be updated by the owner.
    match /merchants/{merchantId} {
      allow read: if true;

      // Allow creation only via backend (e.g. admin approval)
      allow create: if false;

      // Allow merchants to update their own document
      // They can update wallet/status when launching, or general info.
      // They CANNOT change their owner ID.
      allow update: if isSignedIn() && request.auth.uid == resource.data.owner
                    && !('owner' in request.resource.data);

      allow delete: if false; // Deletion should be an admin action
    }

    // Users can only see their own token purchase history.
    // Creation is handled by the backend (Admin SDK).
    match /tokenPurchaseRequests/{requestId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Merchants can only see their own cashout requests.
    // Creation is handled by the backend (Admin SDK).
    match /merchantCashoutRequests/{requestId} {
      allow read: if isSignedIn() && resource.data.merchantId == get(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)).data.merchantId;
      allow write: if false;
    }

    // Blocked users cannot be read or written to by clients.
    match /blocked_users/{userId} {
      allow read, write: if false;
    }
    
    // Lookup table for merchant owners. Can't be modified by clients.
    match /merchant_owners/{userId} {
        allow read, write: if false;
    }

    // Chats and Messages can only be accessed by participants.
    match /chats/{chatId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        // Only the sender of a message can update or delete it.
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }
  }
}
