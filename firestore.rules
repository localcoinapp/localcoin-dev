
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if a user owns a specific merchant document
    function isMerchantOwner(merchantId) {
      return exists(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/merchant_owners/$(request.auth.uid)).data.merchantId == merchantId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can read/write any user document
      allow read, write: if isAdmin();
      // Users can read/write their own document
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      // New users can create their own document
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'blocked_users' collection (Admin-only access)
    match /blocked_users/{userId} {
      allow read, write, delete: if isAdmin();
    }

    // Rules for the 'merchants' collection
    match /merchants/{merchantId} {
      // **PUBLIC ACCESS FIX**: Anyone can read/list merchants if they are live.
      // This is crucial for the main marketplace page.
      allow get: if resource.data.status == 'live';
      allow list: if request.query.get("status") == "live";

      // Admins have full access
      allow read, write: if isAdmin();

      // **MERCHANT OWNER UPDATE FIX**: Allows owners to launch and manage their store status.
      allow update: if request.auth != null && isMerchantOwner(merchantId) && (
        // Condition 1: Launching the store (from 'approved' to 'live')
        (
          request.resource.data.status == 'live' && resource.data.status == 'approved' &&
          request.resource.data.diff(resource.data).affectedKeys().hasAll(['status', 'walletAddress', 'seedPhrase'])
        ) ||
        // Condition 2: Toggling live/paused status
        (
          (request.resource.data.status == 'live' || request.resource.data.status == 'paused') &&
          (resource.data.status == 'live' || resource.data.status == 'paused') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        ) ||
        // Condition 3: General updates to non-critical fields
        (
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName', 'category', 'logo', 'banner', 'description', 'listings', 'position', 'geohash', 'street', 'houseNumber', 'city', 'zipCode', 'website', 'instagram', 'phone', 'contactEmail', 'taxNumber', 'state'])
        )
      );

      // Merchants can create their application
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
    }

    // Rules for the 'merchant_owners' lookup table
    match /merchant_owners/{userId} {
      // Admins can manage these for correction purposes
      allow read, write, delete: if isAdmin();
      // Users can create their own lookup entry when they apply to be a merchant
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Rules for token purchase and cashout requests (Admin and creator access)
    match /tokenPurchaseRequests/{requestId} {
      allow read, write: if isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /merchantCashoutRequests/{requestId} {
      allow read, write: if isAdmin();
      allow create: if request.auth != null && isMerchantOwner(request.resource.data.merchantId);
      allow list: if request.auth != null && isMerchantOwner(request.query.get("merchantId"));
      allow read: if request.auth != null && isMerchantOwner(resource.data.merchantId);
    }
    
    // Rules for chats and messages
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read, write, create, delete: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
