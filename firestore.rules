
rules_version = '2';
service cloud.firestore {

  ////////////////////////////////////////
  // Helpers
  ////////////////////////////////////////
  function isSignedIn() {
    return request.auth != null && request.auth.uid != null;
  }

  function isAdmin() {
    return isSignedIn()
      && exists(/databases/$(database)/documents/users/$(request.auth.uid))
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
  }

  // Only use on *other* collections; see merchants block for in-place check
  function ownsMerchant(merchantId) {
    return isSignedIn()
      && exists(/databases/$(database)/documents/merchants/$(merchantId))
      && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner == request.auth.uid;
  }
  match /databases/{database}/documents {

    ////////////////////////////////////////
    // Merchants
    ////////////////////////////////////////
    match /merchants/{merchantId} {

      // No extra reads of the same doc -> no circular dependency
      function isOwner() {
        return isSignedIn() && resource.data.owner == request.auth.uid;
      }

      // Public can read LIVE merchants; owners/admins can read their own/any merchant
      allow read: if resource.data.status == 'live' || isAdmin() || isOwner();
      
      allow list: if request.query.where.status == 'live' || isAdmin();

      // Owner may launch store: approved -> live (and only set these fields)
      function ownerCanLaunchStore() {
        return resource.data.status == 'approved'
          && request.resource.data.status == 'live'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','walletAddress','seedPhrase']);
      }

      // Owner may toggle live <-> paused (status must change; allow optional metadata)
      function ownerCanToggleStatus() {
        let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status in ['live','paused']
          && request.resource.data.status in ['live','paused']
          && request.resource.data.status != resource.data.status
          && diffKeys.hasOnly(['status','updatedAt','updatedBy','statusNote'])
          && diffKeys.hasAny(['status']);
      }

      // Owner may update general settings (not status/owner)
      function ownerCanUpdateSettings() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'companyName','category','logo','banner','aiHint','position','geohash',
            'description','listings','street','houseNumber','city','zipCode',
            'website','instagram','userEmail','contactEmail','phone','state','taxNumber','country',
            'updatedAt'
          ]);
      }

      // Users can submit their own application
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      
      // Update by admin OR by owner within allowed change sets
      allow update: if isAdmin() || (
        isOwner() && (
          ownerCanLaunchStore() ||
          ownerCanToggleStatus() ||
          ownerCanUpdateSettings()
        )
      );

      // Delete only by admin
      allow delete: if isAdmin();
    }

    ////////////////////////////////////////
    // Merchant owner lookup
    ////////////////////////////////////////
    match /merchant_owners/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    ////////////////////////////////////////
    // Users
    ////////////////////////////////////////
    match /users/{userId} {
      allow list: if isAdmin();
      allow read:   if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    ////////////////////////////////////////
    // Blocked users (admin only)
    ////////////////////////////////////////
    match /blocked_users/{userId} {
      allow read, write: if isAdmin();
    }

    ////////////////////////////////////////
    // Token purchase requests
    ////////////////////////////////////////
    match /tokenPurchaseRequests/{requestId} {
      allow list: if isAdmin();
      // Users see only their own docs; admins see/manage all
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    ////////////////////////////////////////
    // Merchant cashout requests
    ////////////////////////////////////////
    match /merchantCashoutRequests/{requestId} {
      allow list: if isAdmin();
      allow read:   if isAdmin() || (isSignedIn() && ownsMerchant(resource.data.merchantId));
      allow create: if isSignedIn() && ownsMerchant(request.resource.data.merchantId);
      allow update, delete: if isAdmin();
    }

    ////////////////////////////////////////
    // Chats & messages
    ////////////////////////////////////////
    match /chats/{chatId} {
      allow read, update, delete: if isSignedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn()
        && (request.auth.uid in request.resource.data.participantIds || isAdmin());

      match /messages/{messageId} {
        allow read, create, update, delete: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
      }
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
