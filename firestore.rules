rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // This is the most secure way to check for an admin role.
      // It relies on a custom claim set on the user's auth token.
      return request.auth.token.admin == true;
    }

    // --- Collection: users ---
    match /users/{userId} {
      // Admins can read any user document and list the entire collection.
      allow list, get: if isAdmin();
      // Users can only read their own document.
      allow get: if isAuth() && isOwner(userId);
      // Users can update their own document.
      allow update: if isAuth() && isOwner(userId);
      // Allow new user creation during signup.
      allow create: if isAuth();
      // Admins can update or delete any user.
      allow update, delete: if isAdmin();
    }
    
    // --- Collection: blocked_users ---
    match /blocked_users/{userId} {
      // Only admins can read or write to this collection.
      allow read, write: if isAdmin();
    }

    // --- Collection: merchants ---
    match /merchants/{merchantId} {
      // Public can read merchants that are 'live'.
      allow get: if resource.data.status == 'live';
      
      // Admins can read/write any merchant and list the entire collection.
      allow read, write: if isAdmin();

      // Merchant owners can update their own store.
      allow update: if isAuth() && request.auth.uid == resource.data.owner;
      
      // Any authenticated user can create a merchant application.
      allow create: if isAuth();
    }

    // --- Collection: merchant_owners (Lookup Table) ---
    match /merchant_owners/{userId} {
      // Admins can read/write.
      allow read, write: if isAdmin();
      // Only the user themselves can read their own entry.
      allow get: if isAuth() && isOwner(userId);
    }
    
    // --- Collection: chats ---
    match /chats/{chatId} {
        // Participants can read/write to the chat document and its subcollections.
        allow read, write: if isAuth() && request.auth.uid in resource.data.participantIds;
        
        match /messages/{messageId} {
             allow read, create, update, delete: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        }
    }

    // --- Collection: tokenPurchaseRequests ---
    match /tokenPurchaseRequests/{requestId} {
      // Admins can read/write all requests.
      allow read, write: if isAdmin();
      // Users can create requests and read their own.
      allow create: if isAuth();
      allow get: if isAuth() && resource.data.userId == request.auth.uid;
    }
    
    // --- Collection: merchantCashoutRequests ---
    match /merchantCashoutRequests/{requestId} {
        // Admins can read/write all requests.
        allow read, write: if isAdmin();
        // Merchant owners can create requests and read their own.
        function isMerchantOwner() {
          return exists(/databases/$(database)/documents/merchants/$(resource.data.merchantId)) &&
                 get(/databases/$(database)/documents/merchants/$(resource.data.merchantId)).data.owner == request.auth.uid;
        }
        allow create: if isAuth() && isMerchantOwner();
        allow get: if isAuth() && isMerchantOwner();
    }
  }
}
